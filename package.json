{
  "name": "linkcube-nora",
  "version": "1.2.3",
  "description": "Nodejs R/a/dio Archiver",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsx ./tsconfig.json",
    "format": "prettier --write \"helpers/**/*.ts\" \"index.ts\" \"cli_start.ts\"",
    "lint": "eslint -c eslint.config.js . --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A helpers && git add -A index.ts",
    "postversion": "git push && git push --tags",
    "start": "tsx cli_start.ts -s"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkcube/Nora.git"
  },
  "author": "Linkcube",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Linkcube/Nora/issues"
  },
  "homepage": "https://github.com/Linkcube/Nora#readme",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.0.20",
    "@ffprobe-installer/ffprobe": "^1.0.12",
    "command-line-args": "^5.1.1",
    "command-line-usage": "^6.1.1",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "express-graphql": "^0.9.0",
    "fluent-ffmpeg": "^2.1.2",
    "graphql": "^14.5.8",
    "lodash": "^4.17.20",
    "node-id3": "^0.1.11",
    "sanitize-filename": "^1.6.3",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/command-line-args": "^5.0.0",
    "@types/command-line-usage": "^5.0.1",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.14",
    "@types/lodash": "^4.14.149",
    "@types/node": "^26.6.2",
    "@types/request-promise": "^4.1.45",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "globals": "^17.12.0",
    "prettier": "^1.19.1",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "files": [
    "lib/**/*"
  ],
  "bin": "lib/cli_start.js"
}
